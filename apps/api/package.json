{
  "name": "@foodfinder/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsc -p tsconfig.build.json && concurrently -n compiler,server -c yellow,green \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch dist/server.js\"",
    "build": "npm run prisma:generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsc -p tsconfig.seed.json && node dist-seed/prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "cors": "2.8.5",
    "dotenv": "17.2.2",
    "express": "5.2.1",
    "stripe": "22.6.1"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/node": "24.5.2",
    "@types/supertest": "6.0.3",
    "eslint": "9.35.0",
    "prisma": "6.19.3",
    "supertest": "7.2.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.1",
    "vitest": "5.0.0"
  }
}
